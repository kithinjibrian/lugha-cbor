/**
 * Every not-well-formed example of RFC 8949 Appendix F, with the error
 * each must give.
 *
 * Depends on: cbor, support
 */

import cbor { DecodeError, Malformation };
import support { fails };

/** Asserts that every input fails with `e`. */
fun all_fail(inputs: string[], e: DecodeError) {
    for s of inputs {
        fails(s, e);
    }
}

@test
fun end_of_input_in_a_head() {
    all_fail(
        [
            "18", "19", "1a", "1b", "19 01", "1a 01 02", "1b 01 02 03 04 05 06 07", "38", "58", "78",
            "98", "9a 01 ff 00", "b8", "d8", "f8", "f9 00", "fa 00 00", "fb 00 00 00",
        ],
        DecodeError.Truncated,
    );
}

@test
fun definite_strings_with_short_data() {
    all_fail(
        [
            "41", "61", "5a ff ff ff ff 00", "5b ff ff ff ff ff ff ff ff 01 02 03", "7a ff ff ff ff 00",
            "7b 7f ff ff ff ff ff ff ff 01 02 03",
        ],
        DecodeError.Truncated,
    );
}

@test
fun definite_containers_without_enough_items() {
    all_fail(
        ["81", "81 81 81 81 81 81 81 81 81", "82 00", "a1", "a2 01 02", "a1 00", "a2 00 00 00"],
        DecodeError.Truncated,
    );
}

@test
fun tag_without_content() {
    fails("c0", DecodeError.Truncated);
}

@test
fun indefinite_strings_without_a_break() {
    all_fail(["5f 41 00", "7f 61 00"], DecodeError.Truncated);
}

@test
fun indefinite_containers_without_a_break() {
    all_fail(
        [
            "9f", "9f 01 02", "bf", "bf 01 02 01 02", "81 9f", "9f 80 00", "9f 9f 9f 9f 9f ff ff ff ff",
            "9f 81 9f 81 9f 9f ff ff ff",
        ],
        DecodeError.Truncated,
    );
}

@test
fun reserved_additional_information() {
    all_fail(
        [
            "1c", "1d", "1e", "3c", "3d", "3e", "5c", "5d", "5e", "7c", "7d", "7e", "9c", "9d", "9e", "bc",
            "bd", "be", "dc", "dd", "de", "fc", "fd", "fe",
        ],
        DecodeError.Malformed(Malformation.ReservedInfo),
    );
}

@test
fun reserved_two_byte_simple_values() {
    all_fail(["f8 00", "f8 01", "f8 18", "f8 1f"], DecodeError.Malformed(Malformation.ReservedSimple));
}

@test
fun chunks_of_the_wrong_type() {
    all_fail(
        ["5f 00 ff", "5f 21 ff", "5f 61 00 ff", "5f 80 ff", "5f a0 ff", "5f c0 00 ff", "5f e0 ff", "7f 41 00 ff"],
        DecodeError.Malformed(Malformation.BadChunk),
    );
}

@test
fun indefinite_chunks() {
    all_fail(["5f 5f 41 00 ff ff", "7f 7f 61 00 ff ff"], DecodeError.Malformed(Malformation.BadChunk));
}

@test
fun a_lone_break() {
    fails("ff", DecodeError.Malformed(Malformation.UnexpectedBreak));
}

@test
fun a_break_in_a_definite_container_or_tag() {
    all_fail(
        ["81 ff", "82 00 ff", "a1 ff", "a1 ff 00", "a1 00 ff", "a2 00 00 ff", "9f 81 ff", "9f 82 9f 81 9f 9f ff ff ff ff"],
        DecodeError.Malformed(Malformation.UnexpectedBreak),
    );
    fails("c0 ff", DecodeError.Malformed(Malformation.UnexpectedBreak));
}

@test
fun a_break_in_a_map_value_position() {
    all_fail(["bf 00 ff", "bf 00 00 00 ff"], DecodeError.Malformed(Malformation.UnexpectedBreak));
}

@test
fun indefinite_length_on_major_types_0_1_and_6() {
    all_fail(["1f", "3f", "df"], DecodeError.Malformed(Malformation.IndefiniteNotAllowed));
}
