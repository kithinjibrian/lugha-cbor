/**
 * The `Value` helpers, `Value.int` and `SimpleValue`: each happy path and
 * each `None`.
 *
 * Depends on: cbor, support
 */

import cbor { Value, Entry, SimpleValue };
import support { t, u, kv };

/** A small map with a nested map under "props". */
fun node(): Value = Value.Map([
    kv(t("kind"), t("text")),
    kv(u(1), t("not a text key")),
    kv(t("props"), Value.Map([kv(t("text"), t("Count: 3"))])),
]);

/** The nested "props" → "text", through `?`. */
fun props_text(v: Value): Option<string> = v.get("props")?.get("text")?.as_text();

@test
fun get_finds_a_text_key() {
    assert_eq(node().get("kind"), Some(t("text")));
    assert_eq(props_text(node()), Some("Count: 3"));
}

@test
fun get_gives_none() {
    assert_eq(node().get("missing"), None);
    // a key 1 is not the text "1"
    assert_eq(node().get("1"), None);
    assert_eq(t("kind").get("kind"), None);
    assert_eq(Value.Array([t("kind")]).get("kind"), None);
}

@test
fun as_text_and_bytes() {
    assert_eq(t("hi").as_text(), Some("hi"));
    assert_eq(Value.Bytes([1, 2]).as_text(), None);
    assert_eq(Value.Bytes([1, 2]).as_bytes(), Some([1, 2]));
    assert_eq(t("hi").as_bytes(), None);
}

@test
fun as_bool() {
    assert_eq(Value.Bool(true).as_bool(), Some(true));
    assert_eq(Value.Bool(false).as_bool(), Some(false));
    assert_eq(Value.Null.as_bool(), None);
}

@test
fun as_i64() {
    assert_eq(u(5).as_i64(), Some(5));
    assert_eq(u(9223372036854775807).as_i64(), Some(i64.MAX));
    assert_eq(u(9223372036854775808).as_i64(), None);
    assert_eq(u(u64.MAX).as_i64(), None);
    assert_eq(Value.Negative(0).as_i64(), Some(-1));
    assert_eq(Value.Negative(9223372036854775807).as_i64(), Some(i64.MIN));
    assert_eq(Value.Negative(9223372036854775808).as_i64(), None);
    assert_eq(Value.Float(1.0).as_i64(), None);
}

@test
fun as_u64() {
    assert_eq(u(u64.MAX).as_u64(), Some(u64.MAX));
    assert_eq(Value.Negative(0).as_u64(), None);
    assert_eq(t("1").as_u64(), None);
}

@test
fun as_f64() {
    assert_eq(Value.Float(2.5).as_f64(), Some(2.5));
    assert_eq(u(2).as_f64(), None);
}

@test
fun as_array_and_map() {
    assert_eq(Value.Array([u(1)]).as_array(), Some([u(1)]));
    assert_eq(Value.Map([]).as_array(), None);
    let es: Entry[] = [kv(u(1), u(2))];
    assert_eq(Value.Map(es).as_map(), Some(es));
    assert_eq(Value.Array([]).as_map(), None);
}

@test
fun int_builds_both_signs() {
    assert_eq(Value.int(0), u(0));
    assert_eq(Value.int(i64.MAX), u(9223372036854775807));
    assert_eq(Value.int(-1), Value.Negative(0));
    assert_eq(Value.int(i64.MIN), Value.Negative(9223372036854775807));
    assert_eq(Value.int(-42).as_i64(), Some(-42));
}

@test
fun simple_values_exclude_20_to_31() {
    for n of [0, 19, 32, 255] {
        assert_eq(SimpleValue.new(n as u8).map(fun(s) = s.number()), Some(n as u8));
    }
    for n of [20, 23, 24, 31] {
        assert(SimpleValue.new(n as u8).is_none());
    }
}
