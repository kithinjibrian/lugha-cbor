/**
 * Round trips: `decode(encode(v)) == Ok(v)` for every variant, and
 * `encode(decode(b)) == b` for preferred encodings.
 *
 * Depends on: cbor, support
 */

import cbor { Value, SimpleValue, Limits, decode, encode };
import support { hex, t, u, kv };

/** One value of every variant, nested several ways. */
fun everything(): Value = Value.Map([
    kv(t("unsigned"), u(u64.MAX)),
    kv(t("negative"), Value.Negative(u64.MAX)),
    kv(t("bytes"), Value.Bytes([0, 255, 7])),
    kv(t("text"), t("Habari, dunia 🌍")),
    kv(t("array"), Value.Array([u(1), Value.Array([]), Value.Map([])])),
    kv(u(7), Value.Tag(1000, Value.Tag(0, t("nested tags")))),
    kv(Value.Array([u(1), u(2)]), Value.Bool(false)),
    kv(Value.Map([kv(Value.Null, Value.Undefined)]), Value.Bool(true)),
    kv(Value.Float(-0.0), Value.Simple(SimpleValue.new(99).unwrap())),
    kv(Value.Float(1.1), Value.Float(100000.0)),
    kv(Value.Bytes([]), t("")),
]);

@test
fun every_variant_round_trips() {
    let v = everything();
    assert_eq(decode(encode(v), Limits.default()), Ok(v));
}

@test
fun scalars_round_trip() {
    for v of [
        u(0),
        u(23),
        u(24),
        u(255),
        u(256),
        Value.int(-1),
        Value.int(-25),
        Value.int(i64.MIN),
        Value.Float(65505.0),
    ] {
        assert_eq(decode(encode(v), Limits.default()), Ok(v));
    }
}

@test
fun preferred_encodings_come_back_unchanged() {
    for s of [
        "00",
        "1bffffffffffffffff",
        "3bffffffffffffffff",
        "c249010000000000000000",
        "f98000",
        "fb3ff199999999999a",
        "fa47c35000",
        "f90001",
        "f97e00",
        "f8ff",
        "c1fb41d452d9ec200000",
        "64f0908591",
        "98190102030405060708090a0b0c0d0e0f101112131415161718181819",
        "a26161016162820203",
        "a56161614161626142616361436164614461656145",
        "826161a161626163",
    ] {
        let b = hex(s);
        assert_eq(encode(decode(b, Limits.default()).unwrap()), b);
    }
}
